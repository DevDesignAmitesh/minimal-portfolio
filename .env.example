# Copy to .env.local for local dev; add the same keys in Vercel → Project → Settings → Environment Variables.

# View counter (src/app/api/views/route.ts). Upstash console → your database → REST API.
# Use the normal token, not the read-only one: the counter writes. Vercel's Upstash integration
# sets KV_REST_API_URL / KV_REST_API_TOKEN instead, which work too.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Optional: lifts GitHub's 60 req/hour unauthenticated limit for repo descriptions (src/data/github.ts).
GITHUB_TOKEN=
